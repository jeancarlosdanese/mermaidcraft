%% Order processing
flowchart TD
    A[Start] --> B{In stock?}
    B -->|Yes| C([Pack items])
    B -->|No| D[(Back-order)]
    C --> E[[Ship]]
    D -.-> E
    E ==> F((Done))
    subgraph Warehouse
        direction LR
        C
        E
    end
    classDef done fill:#d4f4dd,stroke:#2b8a3e
    class F done
